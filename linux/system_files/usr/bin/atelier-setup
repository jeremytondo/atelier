#!/usr/bin/env bash
# Bootstraps setup for this machine's user: installs mise, then gh and the
# Atelier core through mise, and hands off to `atelier setup`, which logs in to
# GitHub and adopts the owner's dotfiles. The login hook in /etc/profile.d
# starts it on each interactive login until setup has finished.
#
# Usage: atelier-setup [--dotfiles OWNER/REPO] [--token-stdin]
#
#   --dotfiles OWNER/REPO  the GitHub repository to adopt the dotfiles from.
#                          Without it, setup asks.
#   --token-stdin          log in with a gh token read from standard input,
#                          rather than by scanning a QR code. Setup then asks
#                          nothing, so it needs --dotfiles too:
#     gh auth token | ssh <host> atelier-setup --token-stdin --dotfiles OWNER/REPO
#
# Each step is skipped when its result is already there, so a run that failed
# or was interrupted can simply run again.
set -uo pipefail

state=$HOME/.local/state/atelier
mise=$HOME/.local/bin/mise
user=$(id -un)
# The core is released from the Atelier repository with core/vX.Y.Z tags,
# beside the image's linux/vX.Y.Z. mise holds back releases younger than a
# day unless told not to, so a new machine always gets the newest core.
core=github:jeremytondo/atelier
core_latest="${core}[version_prefix=core/v]@latest"

usage() {
    echo "usage: atelier-setup [--dotfiles OWNER/REPO] [--token-stdin]" >&2
    exit 2
}

# Passed on to atelier setup.
args=("$@")
dotfiles=""
# Set by the login hook: this process replaced the login shell.
login=0
while [ $# -gt 0 ]; do
    case $1 in
        # atelier setup reads the token, so nothing here reads stdin.
        --token-stdin) ;;
        --dotfiles)
            [ $# -ge 2 ] || usage
            dotfiles=$2
            shift
            ;;
        --dotfiles=*) dotfiles=${1#*=} ;;
        --login) login=1 ;;
        -h | --help)
            sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
            exit 0
            ;;
        *) usage ;;
    esac
    shift
done

# A run that hasn't finished. From the login hook, end in a plain login shell
# rather than closing the session.
give_up() {
    if [ "$login" = 1 ]; then
        echo "Setup starts again at your next login, or run atelier-setup." >&2
        exec 9>&-
        export ATELIER_SETUP_SKIP=1
        local shell
        shell=$(getent passwd "$user" | cut -d: -f7)
        exec "${shell:-/bin/bash}" -l
    fi
    exit "${1:-1}"
}
trap 'echo; echo "Setup interrupted." >&2; give_up 130' INT

if [ "$(id -u)" = 0 ]; then
    echo "Run atelier-setup as your own user, not root." >&2
    exit 1
fi

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

# With no terminal there's no one to ask, so stop before changing anything.
# atelier setup checks the same, but only once it's installed.
adopted() {
    grep -qs '^\[history\.origin\]' "$HOME/.config/mise/config.local.toml" \
        && [ -e "$HOME/.config/mise/config.toml" ]
}
if [ -z "$dotfiles" ] && [ ! -s "$state/dotfiles" ] && ! adopted && [ ! -t 0 ]; then
    echo "atelier-setup: name the dotfiles repository with --dotfiles OWNER/REPO" >&2
    exit 2
fi

# Held until the hand-off, so two logins don't install at once. Commands that
# might leave a process running close it, so the lock doesn't outlive setup.
mkdir -p "$state" || exit 1
exec 9>"$state/setup.lock"
if ! flock -n 9; then
    echo "Setup is already in progress for $user." >&2
    give_up
fi

step() {
    local name=$1
    shift
    echo "==> $name"
    if ! "$@"; then
        echo "atelier-setup: failed: $name" >&2
        give_up
    fi
}

already() {
    echo "    $*"
}

# The token waits on stdin for atelier setup, so nothing here reads it.
install_mise() {
    if [ -x "$mise" ]; then
        already "mise is installed"
        return
    fi
    # Downloaded first, so a broken download never runs half a script. Quiet
    # drops its advice to edit ~/.zshrc, which the dotfiles handle.
    local installer status
    installer=$(mktemp) || return
    curl -fsSL https://mise.run -o "$installer" && MISE_QUIET=1 sh "$installer" </dev/null
    status=$?
    rm -f "$installer"
    return "$status"
}

# The newest installed version of a tool, if any.
installed() {
    "$mise" ls --installed --json "$1" </dev/null 2>/dev/null | jq -r 'last.version // empty'
}

# Both are installed without writing the global config, which the dotfiles
# bring. Their entries for gh and the core then find these installations.
install_gh() {
    if [ -n "$(installed gh)" ]; then
        already "gh is installed"
        return
    fi
    "$mise" install gh@latest </dev/null 9>&-
}

install_core() {
    if [ -n "$(installed "$core")" ]; then
        already "the Atelier core is installed"
        return
    fi
    "$mise" install --minimum-release-age 0s "$core_latest" </dev/null 9>&-
}

step "Install mise" install_mise
step "Install gh" install_gh
step "Install the Atelier core" install_core

version=$(installed "$core")
if ! atelier=$("$mise" exec "$core@$version" -- sh -c 'command -v atelier' </dev/null) || [ ! -x "$atelier" ]; then
    echo "atelier-setup: can't find atelier in $core@$version" >&2
    give_up
fi

# atelier setup takes the lock itself, and handles interrupts and giving up
# from here on.
exec 9>&-
trap - INT
exec "$atelier" setup "${args[@]}"
